# ローカル専用の値だけを書く。実際の .env.local はコミットしない。
# 使う変数だけ埋めればよい。
# `deployment.method` に合わせて、下の接続方式ブロックを1つ使う。

# 共通: 環境ごとの反映先パス
REMOTE_PATH_PROD=
REMOTE_PATH_STG=
REMOTE_PATH_DEV=

# rsync / ssh 用
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=

# ftp 用
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=

# sftp 用
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASS=
